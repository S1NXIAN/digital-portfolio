# --- Database (SQLite) ---
DATABASE_URL=file:db/custom.db

# --- GitHub contributions sync (optional but recommended) ---
# Token with read:user scope. When the token owner matches the profile's
# githubUsername, synced heatmap counts INCLUDE private commits.
# Create: https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Self-ping keep-alive (opt-in) ---
# "true" enables pinging the app's own health endpoint to keep free hosting
# tiers awake. On Render the target defaults to $RENDER_EXTERNAL_URL/api.
SELF_PING_ENABLED=false
SELF_PING_INTERVAL_MIN=10
# SELF_PING_URL=
